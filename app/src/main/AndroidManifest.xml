<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permessi minimi: rete per il download, servizi/notifiche per
         il download in background (WorkManager, notifica foreground) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NinnaNanna">

        <!-- Riceve l'azione "Stop" della notifica persistente di riproduzione -->
        <receiver
            android:name=".PlaybackStopReceiver"
            android:exported="false" />

        <!-- Foreground service usato da WorkManager per i download:
             deve dichiarare il tipo dataSync (Android 14+) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <!-- Avvio normale -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Condivisione link: "Condividi -> NinnaNanna" -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Apertura link YouTube: youtube.com/watch, youtu.be, ... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="www.youtube.com" />
                <data android:scheme="https" android:host="youtube.com" />
                <data android:scheme="https" android:host="m.youtube.com" />
                <data android:scheme="https" android:host="music.youtube.com" />
                <data android:scheme="https" android:host="youtu.be" />
                <data android:scheme="http" android:host="www.youtube.com" />
                <data android:scheme="http" android:host="youtube.com" />
                <data android:scheme="http" android:host="m.youtube.com" />
                <data android:scheme="http" android:host="music.youtube.com" />
                <data android:scheme="http" android:host="youtu.be" />
            </intent-filter>
        </activity>
    </application>

</manifest>